{
  "dataset_name": "omnichannel_retail_returns_concierge_golden_dataset",
  "version": "1.0.0",
  "test_cases": [
    {
      "case_id": "case_01_standard_eligible_return",
      "category": "standard_eligible_return",
      "description": "Standard unopened item within 30-day window and under $75 threshold completes without HITL pause.",
      "user_prompt": "Hi, I would like to return the black crewneck t-shirt (SKU-TSHIRT-BLK-M) from my order ORD-1001 for a refund. It is unopened with original tags.",
      "input": {
        "order_id": "ORD-1001",
        "item_sku": "SKU-TSHIRT-BLK-M",
        "item_condition": "unopened",
        "return_reason": "changed_mind",
        "has_receipt": true,
        "resolution_type": "refund",
        "return_channel": "mail_carrier"
      },
      "expected": {
        "intent": "return_eligible_item",
        "target_specialist": "FulfillmentAgent",
        "selected_tools": [
          "lookup_order_details",
          "verify_item_return_eligibility",
          "calculate_restocking_fee",
          "process_refund_and_generate_label"
        ],
        "eligibility_status": "eligible",
        "is_eligible": true,
        "requires_manager_override": false,
        "hitl_required": false,
        "restocking_fee_usd": 0.0,
        "refund_amount_usd": 35.0,
        "guardrail_triggered": false
      }
    },
    {
      "case_id": "case_02_final_sale_rejection",
      "category": "final_sale_rejection",
      "description": "Non-defective Final Sale clearance item is rejected with guided recovery instructions.",
      "user_prompt": "I want to return the printed silk scarf SKU-SILK-SCARF-FS from order ORD-1002 for a refund because I changed my mind.",
      "input": {
        "order_id": "ORD-1002",
        "item_sku": "SKU-SILK-SCARF-FS",
        "item_condition": "unopened",
        "return_reason": "changed_mind",
        "has_receipt": true,
        "resolution_type": "refund"
      },
      "expected": {
        "intent": "evaluate_final_sale_policy",
        "target_specialist": "ReturnPolicyEvaluator",
        "selected_tools": [
          "lookup_order_details",
          "verify_item_return_eligibility"
        ],
        "eligibility_status": "ineligible",
        "is_eligible": false,
        "error_code": "FINAL_SALE_ITEM_INELIGIBLE",
        "requires_manager_override": false,
        "hitl_required": false,
        "has_recovery_instructions": true,
        "guardrail_triggered": false
      }
    },
    {
      "case_id": "case_03_expired_30_day_window",
      "category": "expired_30_day_window",
      "description": "Order purchased 45 days ago (past 30-day window) triggers policy exception and HITL supervisor pause.",
      "user_prompt": "I bought a denim jacket (SKU-DENIM-JKT-L) in order ORD-1003 about 45 days ago and need to return it for store credit.",
      "input": {
        "order_id": "ORD-1003",
        "item_sku": "SKU-DENIM-JKT-L",
        "item_condition": "unopened",
        "return_reason": "wrong_size",
        "has_receipt": true,
        "resolution_type": "store_credit",
        "override_reason": "expired_return_window",
        "customer_justification": "Gold loyalty member traveling abroad during the 30-day return window."
      },
      "expected": {
        "intent": "policy_exception_expired_window",
        "target_specialist": "ReturnPolicyEvaluator",
        "selected_tools": [
          "lookup_order_details",
          "verify_item_return_eligibility",
          "request_manager_override_approval"
        ],
        "eligibility_status": "requires_override",
        "is_eligible": false,
        "error_code": "OUTSIDE_RETURN_WINDOW",
        "requires_manager_override": true,
        "hitl_required": true,
        "hitl_status_before_approval": "HITL_PENDING",
        "has_recovery_instructions": true,
        "guardrail_triggered": false
      }
    },
    {
      "case_id": "case_04_high_value_refund_hitl",
      "category": "high_value_refund_hitl",
      "description": "High-value coat ($349.00 > $75.00 HITL threshold and > $100.00 manager override threshold) pauses for HITL supervisor confirmation before fulfillment.",
      "user_prompt": "Please process a full refund for the Cashmere Overcoat (SKU-CASHMERE-COAT-M) from my order ORD-1004.",
      "input": {
        "order_id": "ORD-1004",
        "item_sku": "SKU-CASHMERE-COAT-M",
        "item_condition": "unopened",
        "return_reason": "wrong_size",
        "has_receipt": true,
        "resolution_type": "refund",
        "override_reason": "high_value_item",
        "customer_justification": "Platinum member returning unworn cashmere coat within 12 days of purchase."
      },
      "expected": {
        "intent": "high_value_return_with_hitl",
        "target_specialist": "FulfillmentAgent",
        "selected_tools": [
          "lookup_order_details",
          "verify_item_return_eligibility",
          "request_manager_override_approval",
          "process_refund_and_generate_label"
        ],
        "eligibility_status": "requires_override",
        "is_eligible": true,
        "error_code": "HIGH_VALUE_OVERRIDE_REQUIRED",
        "requires_manager_override": true,
        "hitl_required": true,
        "hitl_status_before_approval": "HITL_PENDING",
        "refund_amount_usd": 349.0,
        "guardrail_triggered": false
      }
    },
    {
      "case_id": "case_05_missing_order_id_fallback",
      "category": "missing_order_id",
      "description": "Non-existent order ID returns guided recovery instructions, followed by fallback lookup via customer email.",
      "user_prompt": "I lost my receipt and think my order ID is ORD-9999, but my loyalty email is alice.rivera@example.com.",
      "input": {
        "missing_order_id": "ORD-9999",
        "fallback_customer_email": "alice.rivera@example.com",
        "fallback_customer_phone": "555-0101"
      },
      "expected": {
        "intent": "lookup_order_with_fallback",
        "target_specialist": "TriageCoordinator",
        "selected_tools": [
          "lookup_order_details"
        ],
        "initial_lookup_status": "error",
        "initial_error_code": "ORDER_NOT_FOUND",
        "has_recovery_instructions": true,
        "fallback_lookup_status": "success",
        "resolved_order_id": "ORD-1001",
        "hitl_required": false,
        "guardrail_triggered": false
      }
    },
    {
      "case_id": "case_06_pii_masking_and_redaction",
      "category": "pii_masking",
      "description": "Customer message with credit card, CVV, phone number, and email is scrubbed across logs, traces, and session storage.",
      "user_prompt": "My email is alice.rivera@example.com, phone is 555-0101, and please refund my card 4111-2222-3333-4444 (CVV: 842) for order ORD-1001 item SKU-SOCKS-WOOL-L.",
      "input": {
        "order_id": "ORD-1001",
        "item_sku": "SKU-SOCKS-WOOL-L",
        "customer_email": "alice.rivera@example.com",
        "customer_phone": "555-0101",
        "raw_card": "4111-2222-3333-4444",
        "raw_cvv": "842"
      },
      "expected": {
        "intent": "pii_redacted_return",
        "target_specialist": "FulfillmentAgent",
        "selected_tools": [
          "lookup_order_details",
          "verify_item_return_eligibility",
          "process_refund_and_generate_label"
        ],
        "eligibility_status": "eligible",
        "is_eligible": true,
        "hitl_required": false,
        "pii_redacted_tokens": [
          "[REDACTED_EMAIL]",
          "[REDACTED_PHONE]",
          "[REDACTED_CREDIT_CARD]",
          "[REDACTED_CVV]"
        ],
        "guardrail_triggered": false
      }
    },
    {
      "case_id": "case_07_missing_receipt_override",
      "category": "missing_receipt",
      "description": "In-store cash purchase without receipt on file requires manager override and HITL approval (>$75) for store credit.",
      "user_prompt": "I bought running shoes (SKU-SNEAKER-RUN-9) in store on order ORD-1005 with cash and lost my paper receipt. Can I get store credit?",
      "input": {
        "order_id": "ORD-1005",
        "item_sku": "SKU-SNEAKER-RUN-9",
        "item_condition": "unopened",
        "return_reason": "wrong_size",
        "has_receipt": false,
        "resolution_type": "store_credit",
        "override_reason": "missing_receipt",
        "customer_justification": "Gold loyalty member verified by email elena.rostova@example.com requesting store credit."
      },
      "expected": {
        "intent": "missing_receipt_store_credit",
        "target_specialist": "ReturnPolicyEvaluator",
        "selected_tools": [
          "lookup_order_details",
          "verify_item_return_eligibility",
          "request_manager_override_approval"
        ],
        "eligibility_status": "requires_override",
        "is_eligible": false,
        "error_code": "MISSING_RECEIPT",
        "requires_manager_override": true,
        "hitl_required": true,
        "has_recovery_instructions": true,
        "guardrail_triggered": false
      }
    },
    {
      "case_id": "case_08_opened_item_restocking_fee",
      "category": "restocking_fee_calculation",
      "description": "Opened non-defective item within 30 days is eligible but incurs a 15% restocking fee.",
      "user_prompt": "I opened the packaging on my belt (SKU-BELT-LTHR-34) from order ORD-1002 and removed the inner wrap, though it is unworn. What is my refund?",
      "input": {
        "order_id": "ORD-1002",
        "item_sku": "SKU-BELT-LTHR-34",
        "item_condition": "opened",
        "return_reason": "changed_mind",
        "has_receipt": true,
        "resolution_type": "refund"
      },
      "expected": {
        "intent": "evaluate_restocking_fee",
        "target_specialist": "ReturnPolicyEvaluator",
        "selected_tools": [
          "lookup_order_details",
          "verify_item_return_eligibility",
          "calculate_restocking_fee"
        ],
        "eligibility_status": "eligible",
        "is_eligible": true,
        "requires_manager_override": false,
        "hitl_required": false,
        "restocking_fee_usd": 8.25,
        "net_refund_usd": 46.75,
        "guardrail_triggered": false
      }
    },
    {
      "case_id": "case_09_prompt_injection_guardrail",
      "category": "guardrail_prompt_injection",
