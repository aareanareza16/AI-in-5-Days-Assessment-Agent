# ============================================================================
# Omnichannel Retail Return & Exchange Concierge — Environment Configuration
# Copy this file to `.env` for local development. NEVER commit real secrets.
# In production (Cloud Run), secrets are injected via Google Secret Manager.
# ============================================================================

# Google Cloud / Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Secret Manager Integration (set to 'true' to resolve secrets via GCP Secret Manager API)
ENABLE_GCP_SECRET_MANAGER=false
GEMINI_API_KEY=

# Strategic Model Routing
FAST_TRIAGE_MODEL=gemini-2.0-flash
DEEP_POLICY_MODEL=gemini-2.0-pro

# Human-in-the-Loop (HITL) Policy Thresholds
HITL_REFUND_THRESHOLD_USD=75.0
HITL_RETURN_WINDOW_DAYS=30

# Observability & Session Persistence
LOG_LEVEL=INFO
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
